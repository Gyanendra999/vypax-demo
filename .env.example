# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (Optional for production multi-tenant database & auth)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Secret for Session & Auth Token Signing
JWT_SECRET="vyaapx-super-secure-production-trade-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# Port & Environment
PORT=3000
NODE_ENV="development"
